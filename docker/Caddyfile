# Caddy для публикации салона в интернет (см. docker-compose.prod.yml).
#
# Домен берётся из переменной окружения DOMAIN (задаётся в .env).
# Caddy автоматически получает сертификат Let's Encrypt и продлевает его,
# настраивает HTTP -> HTTPS редирект и HTTP/2, а также передаёт реальный
# IP посетителя в заголовке X-Forwarded-For (его использует ограничение
# частоты запросов в приложении).

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy salon:8000

	header {
		# Не отдаём наружу лишнюю информацию о сервере.
		-Server
	}
}