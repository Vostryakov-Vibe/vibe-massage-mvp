# ===========================================================================
#  Настройки приложения. Скопируйте файл в .env и заполните значения.
#  ВАЖНО: приложение работает и БЕЗ этого файла — все параметры имеют
#  безопасные значения по умолчанию (см. config.py).
# ===========================================================================

# --- Основное -------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Cookie сессии отправлять только по HTTPS. Включайте при публикации в
# интернет за HTTPS-прокси (в docker-compose.prod.yml включено).
SESSION_HTTPS_ONLY=false

# Домен для публикации на сервере (использует docker-compose.prod.yml).
# Локальному запуску не нужен.
DOMAIN=

# Название и контакты салона (выводятся на лендинге и в шапке админки)
SALON_NAME=Салон массажа «Гармония»
SALON_TAGLINE=Профессиональный оздоровительный массаж
SALON_ADDRESS=г. Москва, ул. Примерная, д. 10, офис 25
SALON_PHONE=+7 (495) 123-45-67
SALON_EMAIL=info@harmony-massage.local
SALON_HOURS=Ежедневно с 09:00 до 21:00
SALON_TELEGRAM=https://t.me/harmony_massage
SALON_VK=https://vk.com/harmony_massage
SALON_WHATSAPP=https://wa.me/74951234567

# --- Учётные записи по умолчанию (создаются при первом запуске) ------------
DEFAULT_SUPERADMIN_LOGIN=admin
DEFAULT_SUPERADMIN_PASSWORD=admin777
DEFAULT_MANAGER_LOGIN=manager
DEFAULT_MANAGER_PASSWORD=manager777

# --- Telegram: уведомления о новых записях --------------------------------
# Токен от @BotFather и id чата сотрудников. Если пусто — уведомления
# не отправляются, в консоль пишется предупреждение (приложение не падает).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- VK: публикация маркетинговых постов в группу -------------------------
VK_ACCESS_TOKEN=
VK_GROUP_ID=

# --- Cloudflare Turnstile (антиспам) --------------------------------------
# Если оба ключа заполнены — форма записи использует Turnstile (нужен интернет).
# Если пусто — работает встроенная офлайн-защита: honeypot-поле, проверка
# времени заполнения формы и лимит запросов с одного IP.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Маркетинговый ИИ -----------------------------------------------------
# Бесплатный текстовый API. Если недоступен (нет интернета) — включается
# офлайн-fallback со встроенными шаблонами постов.
AI_API_URL=https://text.pollinations.ai
AI_API_TIMEOUT=25

# --- Прочее ---------------------------------------------------------------
# Сколько дней хранить архив сгенерированных постов
POSTS_RETENTION_DAYS=30
# Шаг сетки таймслотов в минутах
SLOT_STEP_MINUTES=30
# За сколько минут до начала нельзя записаться на сегодня
MIN_LEAD_MINUTES=60
